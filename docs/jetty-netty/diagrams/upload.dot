digraph upload {
  graph [rankdir=LR, bgcolor="white", pad="0.08", nodesep="0.24", ranksep="0.20", splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=12, fontcolor="#15344B", fillcolor="#EFF6FA", color="#45788F", penwidth=1.1, margin="0.10,0.08"];
  edge [color="#417C89", penwidth=1.1, arrowsize=0.7, fontname="Noto Sans", fontsize=12, fontcolor="#15344B"];

  ready [label="pumpUpload()\ninput.isReady()\nchannel.isWritable()"];
  read [label="input.read(...)\npooled ByteBuf\nJetty direct / heap"];
  index [label="count > 0\nwriterIndex(count)", fillcolor="#E0F2EF", color="#2D827B"];
  write [label="writeAndFlush()\nDefaultHttpContent\nбуфер принадлежит Netty"];
  promise [label="Write promise\nuploadBusy=false\nsignal()", fillcolor="#E0F2EF", color="#2D827B"];
  eof [label="endUpload()\nLastHttpContent\nпроверка длины"];
  {rank=same; ready; eof;}
  {rank=same; read; promise;}
  {rank=same; index; write;}
  ready -> read -> index;
  index -> write [constraint=false];
  write -> promise -> ready [constraint=false];
  ready -> eof [constraint=false, label="EOF"];
  eof -> promise -> write [style=invis, weight=10];
}
