digraph Headers {
  graph [rankdir=LR, bgcolor="white", fontname="Noto Sans", fontsize=12, pad=0.06,
         nodesep=0.24, ranksep=0.20, splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=12,
        fontcolor="#15344B", fillcolor="#EFF6FA", color="#45788F", penwidth=1.1, margin="0.11,0.09"];
  edge [color="#417C89", penwidth=1.2, arrowsize=0.7, fontname="Noto Sans", fontsize=12];

  source [label="Исходные поля\nзапрос / ответ"];
  initial [label="sanitize()\nубрать служебные"];
  editor [label="ProxyHeaderEditor\nотдельная копия", fillcolor="#E0F2EF", color="#2D827B"];
  metadata [label="ProxyRequestMetadata\nнеизменяемый снимок", style="rounded,dashed,filled"];
  hooks [label="global → plan → patch\nfreeze() + close()", fillcolor="#E0F2EF", color="#2D827B"];
  final [label="sanitize()\nConnection-поля"];
  apply [label="Request.headers()\nили applyResponse()"];

  { rank=same; source; apply; }
  { rank=same; initial; metadata; final; }
  { rank=same; editor; hooks; }
  source -> apply [style=invis, weight=30];
  initial -> metadata -> final [style=invis, weight=30];
  source -> initial;
  initial -> editor;
  editor -> hooks;
  metadata -> hooks [style=dashed, constraint=false];
  hooks -> final [constraint=false];
  final -> apply [constraint=false];
}
