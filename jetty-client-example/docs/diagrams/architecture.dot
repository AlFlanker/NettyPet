digraph Architecture {
  graph [rankdir=LR, bgcolor="white", fontname="Noto Sans", fontsize=12, pad=0.06,
         nodesep=0.25, ranksep=0.25, splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=12,
        fontcolor="#15344B", fillcolor="#EFF6FA", color="#45788F", penwidth=1.1, margin="0.14,0.09"];
  edge [color="#417C89", penwidth=1.2, arrowsize=0.7, fontname="Noto Sans", fontsize=12];

  client [label="Клиент\nHTTP-запрос"];
  jetty [label="Host / demo\nJetty Filter chain"];
  local [label="Local MVC\nили resource loader\nbounded fetch"];
  servlet [label="Application Filter\nвыбранный handler\nSpring adapter optional", fillcolor="#E0F2EF", color="#2D827B"];
  http [label="Core JAR\nEngine / FetchClient\nshared HttpClient", fillcolor="#E0F2EF", color="#2D827B"];
  upstream [label="HTTP(S) upstream\ntarget из plan"];

  { rank=same; client; upstream; }
  { rank=same; jetty; http; }
  { rank=same; local; servlet; }
  client -> upstream [style=invis, weight=30];
  jetty -> http [style=invis, weight=30];
  local -> servlet [style=invis, weight=30];
  client -> jetty;
  jetty -> local;
  jetty -> servlet;
  servlet -> http [constraint=false];
  local -> http [constraint=false];
  http -> upstream [constraint=false];
}
