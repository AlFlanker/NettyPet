digraph Exchange {
  graph [rankdir=LR, bgcolor="white", fontname="Noto Sans", fontsize=12, pad=0.06,
         nodesep=0.30, ranksep=0.20, splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=12,
        fontcolor="#15344B", fillcolor="#EFF6FA", color="#45788F", penwidth=1.1, margin="0.11,0.09"];
  edge [color="#417C89", penwidth=1.2, arrowsize=0.7, fontname="Noto Sans", fontsize=12];

  service [label="service()\nadmission\nstartAsync()"];
  owner [label="dispatch()\ndrain() → start()\nsend()", fillcolor="#E0F2EF", color="#2D827B"];
  upload [label="pumpUpload()\nread → write"];
  download [label="onHeaders()\npumpDownload()"];
  cleanup [label="finishCleanup()\nпосле callbacks\npermit назад", fillcolor="#E0F2EF", color="#2D827B"];

  { rank=same; upload; download; }
  upload -> download [style=invis, weight=20];
  service -> owner;
  owner -> upload;
  owner -> download;
  upload -> cleanup;
  download -> cleanup;
}
