digraph Startup {
  graph [rankdir=LR, bgcolor="white", fontname="Noto Sans", fontsize=12, pad=0.06,
         nodesep=0.34, ranksep=0.35, splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Noto Sans", fontsize=12,
        fontcolor="#15344B", fillcolor="#EFF6FA", color="#45788F", penwidth=1.1, margin="0.14,0.09"];
  edge [color="#417C89", penwidth=1.2, arrowsize=0.7, fontname="Noto Sans", fontsize=12];

  main [label="main()\nSpringApplication.run()\nbinding свойств"];
  client [label="jettyHttpClient()\nclient.start()\nwhitelist обработчиков", fillcolor="#E0F2EF", color="#2D827B"];
  servlet [label="jettyProxyServlet()\norderedStream()\nсписок customizers"];
  registration [label="jettyProxyServletRegistration()\n/proxy и /proxy/*\nasyncSupported = true", fillcolor="#E0F2EF", color="#2D827B"];

  { rank=same; main; servlet; }
  { rank=same; client; registration; }
  main -> servlet [style=invis, weight=30];
  client -> registration [style=invis, weight=30];
  main -> client;
  client -> servlet [constraint=false];
  servlet -> registration;
}
